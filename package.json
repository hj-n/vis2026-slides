    "build:visauto": "node scripts/build.mjs visauto",
    "build:dab": "node scripts/build.mjs dab",
    "build:misuse": "node scripts/build.mjs misuse",
    "build:umato": "node scripts/build.mjs umato"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@slidev/cli": "52.18.0",
    "@slidev/theme-default": "0.25.0",
    "vue": "3.5.40",
